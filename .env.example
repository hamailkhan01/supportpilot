# Copy this file to .env.local and fill in ONE key.
# With no key at all, the app runs in free "demo mode" (answers straight from the docs, no AI).

# Claude (Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI: https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: force a provider when both keys are set (anthropic | openai)
AI_PROVIDER=

# Optional: max chat messages per visitor per minute (default 20)
RATE_LIMIT_PER_MINUTE=20
